# ─── Base de datos (Supabase usado solo como PostgreSQL) ───────────────────────
# App: pooler de Supabase en modo transacción (puerto 6543). pgbouncer=true y connection_limit=1 son obligatorios.
DATABASE_URL="postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (5432): solo para herramientas de Prisma. El backend NO ejecuta migraciones (la base la crean los scripts de ../sql).
DIRECT_URL="postgresql://postgres:<contraseña>@db.<ref>.supabase.co:5432/postgres"

# ─── Autenticación ─────────────────────────────────────────────────────────────
# Secreto HS256 del access token: mínimo 32 caracteres aleatorios (p. ej. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))").
JWT_ACCESS_SECRET="cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
# Vida del access token en segundos (15 min).
JWT_ACCESS_TTL_SECONDS=900
# Vida del refresh token en días (rotativo).
REFRESH_TOKEN_TTL_DAYS=7

# ─── HTTP ──────────────────────────────────────────────────────────────────────
PORT=3000
# Orígenes permitidos por CORS (separados por coma). Default: el frontend en desarrollo.
CORS_ORIGIN="http://localhost:3001"
# true si la API corre detrás de un proxy/balanceador (para registrar la IP real en auditoría).
TRUST_PROXY=false

# ─── Procesos automáticos ──────────────────────────────────────────────────────
# true: baja automática diaria, cierres de mes y recuperación al arrancar. Poné false en réplicas extra si querés
# que una sola instancia corra los crons (igual están protegidos con pg_try_advisory_xact_lock).
JOBS_ENABLED=true

# ─── Solo pruebas ──────────────────────────────────────────────────────────────
# Congela el reloj del negocio (ISO 8601). Dejar vacío en producción.
FIXED_NOW=
